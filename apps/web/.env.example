# Variables públicas del frontend web (NEXT_PUBLIC_*). Copiar a .env.local.

# URL de la API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Datos del municipio (usados en textos/OG).
NEXT_PUBLIC_MUNICIPIO_NOMBRE=Rivadavia

# Mapa (§07.0.A): tiles propios servidos como archivo estático. NO usar el tile server público
# de OSM en producción. Por defecto se sirven desde /tiles del propio hosting.
# Ver docs/tiles-mapa.md para generar el extracto de San Juan.
NEXT_PUBLIC_TILES_URL=/tiles/{z}/{x}/{y}.png
NEXT_PUBLIC_TILES_ATTR=Mapa © OpenStreetMap · Municipio

# Convenio de adhesión de comercios (versión vigente).
NEXT_PUBLIC_CONVENIO_VERSION=v1
