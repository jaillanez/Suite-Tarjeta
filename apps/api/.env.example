# Copiar a .env y ajustar. NUNCA commitear .env con secretos reales.
# Prefijo de entorno: TARJETA_

# Aplicación
TARJETA_ENVIRONMENT=dev
TARJETA_DEBUG=true

# Municipio (única fuente del nombre/zona: no escribir esto en el código)
TARJETA_MUNICIPIO_NOMBRE=Rivadavia
TARJETA_MUNICIPIO_PROVINCIA=San Juan
TARJETA_MUNICIPIO_TIMEZONE=America/Argentina/San_Juan
TARJETA_MUNICIPIO_LOGO_URL=

# CORS (JSON list)
TARJETA_CORS_ORIGINS=["http://localhost:3000"]

# Base de datos — DOS URLs separadas (roles distintos)
#   database_url          -> rol tarjeta_app       (runtime, sin DDL)
#   database_migrator_url -> rol tarjeta_migrator  (solo Alembic, dueño del esquema)
TARJETA_DATABASE_URL=postgresql+psycopg://tarjeta_app@localhost:5432/tarjeta
TARJETA_DATABASE_MIGRATOR_URL=postgresql+psycopg://tarjeta_migrator@localhost:5432/tarjeta
TARJETA_DATABASE_POOL_SIZE=10

# Redis
TARJETA_REDIS_URL=redis://localhost:6379/0

# Endpoint del padrón municipal (server-to-server; nunca desde la app)
TARJETA_PADRON_BASE_URL=http://localhost:9999/padron
TARJETA_PADRON_API_KEY=reemplazar-por-clave-real
TARJETA_PADRON_TIMEOUT_SECONDS=5.0
TARJETA_PADRON_CACHE_TTL_SECONDS=21600

# Seguridad
TARJETA_JWT_SECRET=reemplazar-por-secreto-largo-y-aleatorio
TARJETA_JWT_ACCESS_TTL_SECONDS=900
TARJETA_QR_TOKEN_ROTATION_SECONDS=45
TARJETA_QR_TOKEN_VALIDITY_SECONDS=90

# Parámetros del programa
TARJETA_PUNTOS_VENCIMIENTO_MESES=24
TARJETA_GRUPO_MAX_MIEMBROS=6
TARJETA_GRUPO_COOLDOWN_DIAS=90
TARJETA_GRUPO_MAX_ALTAS_ANUALES=4
TARJETA_GRUPO_MAX_BAJAS_ANUALES=4
TARJETA_CAMBIO_MODO_BILLETERA_DIAS=180
TARJETA_ANULACION_VENTANA_MINUTOS=15
TARJETA_SESION_MUNICIPAL_TIMEOUT_MINUTOS=10
TARJETA_CUOTA_IA_MENSUAL_POR_COMERCIO=10

# Feature flags
TARJETA_FF_CANJE_CONTRA_TASAS=false
TARJETA_FF_GENERACION_IA=true
TARJETA_FF_PUBLICACION_REDES=true
