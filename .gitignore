# === Python / backend ===
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# === Node / frontend ===
node_modules/
.pnp/
.pnp.js
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# === Móvil (Capacitor) ===
# Los proyectos nativos (apps/mobile/android, apps/mobile/ios) SÍ se versionan: ahí viven íconos,
# permisos del manifiesto y versionCode/versionName. Sus salidas de build (build/, .gradle/,
# local.properties, *.apk/*.aab, Pods, DerivedData) las ignora el .gitignore interno de cada
# proyecto + las reglas de arriba (build/). Ver docs/compilar-apk.md.
apps/mobile/android/local.properties
apps/mobile/ios/App/Pods/
apps/mobile/ios/App/App/public/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# === Entornos y secretos ===
.env
.env.*
!.env.example
*.pem
*.key

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# === Cobertura / caché ===
coverage/
.coverage
.coverage.*
coverage.json
htmlcov/
.cache/

# === Sistema operativo / editores ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Tiles del mapa: artefactos de build y tiles generados (se suben al hosting, no a git). §07.0.A
scripts/.tiles-build/
apps/web/public/tiles/*
!apps/web/public/tiles/.gitkeep
!apps/web/public/tiles/README.md

# Config de producción con secretos (§15.1): el real NUNCA se commitea; el .ejemplo sí.
config/produccion.env

# Artefactos de build de apps (§15.4) y keystore de firma (irreemplazable: resguardar aparte)
build/
config/*.jks
