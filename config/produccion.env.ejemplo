# Configuración de PRODUCCIÓN (§15.1) — ejemplo versionado.
#
# Copiar a `config/produccion.env` (ese archivo está en .gitignore: NUNCA se commitea) y completar
# con los valores reales. Verificar con:  uv run --project apps/api python -m tarjeta.scripts.verificar_config
# Cargar antes de arrancar la app:        set -a; source config/produccion.env; set +a
#
# Guardando este archivo se resuelve la custodia de la clave de cifrado (§1.3): NO va a un gestor
# de secretos aparte, va acá. Resguardalo.

# --- Entorno ---
TARJETA_ENVIRONMENT=prod
TARJETA_DEBUG=false
TARJETA_CORS_ORIGINS=["https://app.rivadavia.gob.ar"]

# --- Base de datos (dos roles) ---
TARJETA_DATABASE_URL=postgresql+psycopg://tarjeta_app:CAMBIAR@db.interno:5432/tarjeta
TARJETA_DATABASE_MIGRATOR_URL=postgresql+psycopg://tarjeta_migrator:CAMBIAR@db.interno:5432/tarjeta
TARJETA_REDIS_URL=redis://redis.interno:6379/0

# --- Padrón municipal (server-to-server) ---
TARJETA_PADRON_MODO=real
TARJETA_PADRON_BASE_URL=https://padron.rivadavia.gob.ar
TARJETA_PADRON_API_KEY=CAMBIAR-por-clave-real-del-padron

# --- Seguridad / cifrado de campos ---
# key: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# pepper: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TARJETA_JWT_SECRET=CAMBIAR-por-secreto-largo-y-aleatorio-32-bytes-minimo
TARJETA_FIELD_ENCRYPTION_KEY=CAMBIAR-por-base64-urlsafe-de-32-bytes
TARJETA_FIELD_PEPPER=CAMBIAR-por-pepper-aleatorio
TARJETA_FIELD_ENCRYPTION_KEY_VERSION=v1

# --- Correo (§15.2): los cinco datos del proveedor ---
TARJETA_EMAIL_PROVEEDOR=real
TARJETA_EMAIL_SMTP_HOST=smtp.proveedor.com
TARJETA_EMAIL_SMTP_PORT=587
TARJETA_EMAIL_SMTP_USER=CAMBIAR-usuario-smtp
TARJETA_EMAIL_SMTP_PASSWORD=CAMBIAR-contraseña-smtp
TARJETA_EMAIL_FROM=Tarjeta de Beneficios <no-responder@rivadavia.gob.ar>

# --- Tiles del mapa (frontend; §14.1: en prod es obligatoria o el mapa no carga) ---
NEXT_PUBLIC_TILES_URL=https://tiles.rivadavia.gob.ar/{z}/{x}/{y}.png
NEXT_PUBLIC_TILES_ATTR=Mapa © OpenStreetMap · Municipio de Rivadavia

# --- Firma del AAB de Android (§15.4): se completa al generar el keystore ---
ANDROID_KEYSTORE_PASSWORD=CAMBIAR-al-generar-el-keystore
